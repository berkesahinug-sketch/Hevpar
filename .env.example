# Kopiere diese Datei zu ".env" und trage die Werte deines Supabase-Projekts
# ein (Dashboard -> Settings -> API). Beide Werte sind oeffentlich-sicher.
# Den service_role-Schluessel NIEMALS hier oder sonstwo in der App eintragen.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY
